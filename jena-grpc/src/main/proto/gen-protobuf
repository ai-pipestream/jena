#!/bin/bash
## Licensed under the terms of http://www.apache.org/licenses/LICENSE-2.0

## Must run in the jena-grpc/src/main/proto directory within the Jena codebase.

set -euo pipefail

ROOT="$(cd ../../../.. ; pwd)"
ARQ_PROTO_DIR="$ROOT/jena-arq/Grammar/RDF-Protobuf"
PROTO="org/apache/jena/grpc/v1/rdf_service.proto"
OUTPUT="../java/org/apache/jena/grpc/wire/PB_RDFService.java"

if command -v buf >/dev/null 2>&1; then
    TMP_PROTO_DIR="$(mktemp -d)"
    trap 'rm -rf "$TMP_PROTO_DIR"' EXIT
    cp -R . "$TMP_PROTO_DIR/"
    cp "$ARQ_PROTO_DIR/binary-rdf.proto" "$TMP_PROTO_DIR/binary-rdf.proto"
    buf lint "$TMP_PROTO_DIR" --path "$TMP_PROTO_DIR/$PROTO"
fi

PROTOC_BIN="${PROTOC:-}"
if [ -z "$PROTOC_BIN" ]; then
    if [ -x "$HOME/.m2/repository/com/google/protobuf/protoc/4.28.2/protoc-4.28.2-linux-x86_64.exe" ]; then
        PROTOC_BIN="$HOME/.m2/repository/com/google/protobuf/protoc/4.28.2/protoc-4.28.2-linux-x86_64.exe"
    else
        PROTOC_BIN="protoc"
    fi
fi

mkdir -p "$(dirname "$OUTPUT")"
rm -f "$OUTPUT"

"$PROTOC_BIN" \
    --proto_path="$PWD" \
    --proto_path="$ARQ_PROTO_DIR" \
    --java_out="../java" \
    "$PROTO"

if [ -e "$OUTPUT" ]; then
    perl -i -p -e \
        's/^public final class/\@SuppressWarnings("all")\npublic final class/' \
        "$OUTPUT"
    (
        echo "/*"
        sed -e 's/^/ * /' -e 's/ *$//' "$ROOT/build-files/license-header"
        echo " */"
        echo
        cat "$OUTPUT"
    ) > "$OUTPUT.tmp"
    mv "$OUTPUT.tmp" "$OUTPUT"
else
    echo "No output generated at $OUTPUT" 2>&1
    exit 1
fi
